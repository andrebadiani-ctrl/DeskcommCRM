# Copie para ".env" e preencha (o instalar-vps.sh faz isso perguntando).
# Domínio que aponta para esta VPS (registro A no DNS), sem https://
DOMINIO=leads.suaempresa.com.br
# Senha para entrar no sistema (usuário: qualquer um). Use uma senha forte.
APP_PASSWORD=
# Fuso horário das notas e do painel
TZ=America/Sao_Paulo
# Opcional: chave da API da Anthropic para o assistente de IA (também dá para colar na tela)
ANTHROPIC_API_KEY=
